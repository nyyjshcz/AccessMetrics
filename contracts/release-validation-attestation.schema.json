{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "finalCandidate",
    "rcCommit",
    "publicationRevisionBefore",
    "publicationRevisionLocked",
    "verifiedTreeHash",
    "r4EvidenceBundleHash",
    "fullGateBundleHash",
    "sourceExportId",
    "sourceManifestHash",
    "finalExportId",
    "finalManifestHash",
    "commandResults",
    "startedAt",
    "completedAt",
    "verifierVersion",
    "errors",
    "attestationHash"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "release-validation-attestation-v1" },
    "status": { "enum": ["passed", "failed"] },
    "finalCandidate": { "type": ["string", "null"] },
    "rcCommit": { "type": ["string", "null"] },
    "publicationRevisionBefore": { "type": ["integer", "null"] },
    "publicationRevisionLocked": { "type": ["integer", "null"] },
    "verifiedTreeHash": { "type": ["string", "null"] },
    "r4EvidenceBundleHash": { "type": ["string", "null"] },
    "fullGateBundleHash": { "type": ["string", "null"] },
    "sourceExportId": { "type": ["string", "null"] },
    "sourceManifestHash": { "type": ["string", "null"] },
    "finalExportId": { "type": ["string", "null"] },
    "finalManifestHash": { "type": ["string", "null"] },
    "commandResults": { "type": "array", "items": { "type": "object" } },
    "startedAt": { "type": "string" },
    "completedAt": { "type": "string" },
    "verifierVersion": { "type": "string" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "attestationHash": { "type": "string" }
  }
}
