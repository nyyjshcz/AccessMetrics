{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "role",
    "commit",
    "r1R4IndexHash",
    "handoffCatalogHash",
    "confirmGateIds",
    "evidence",
    "confirmed"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "r5-handoff-v1" },
    "role": { "enum": ["computer_lead", "math_lead"] },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "r1R4IndexHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "handoffCatalogHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "confirmGateIds": {
      "type": "array",
      "prefixItems": [
        { "const": "A" },
        { "const": "B" },
        { "const": "C" },
        { "const": "D" },
        { "const": "E" }
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "evidence": {
      "type": "object",
      "required": ["files", "evidenceHash"],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "evidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "confirmed": { "const": true }
  }
}
