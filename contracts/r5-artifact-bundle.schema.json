{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "artifactHashes", "bundleHash", "status"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "r5-artifact-bundle-v1" },
    "artifactHashes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "bundleHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "const": "verified" }
  }
}
