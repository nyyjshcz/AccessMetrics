APP_ENV=development
DATABASE_URL=./data/accesscheck.db
# Stable encryption and session-signing key. Replace with a random value;
# production must never use this example/default value.
SESSION_SECRET=replace-with-at-least-32-random-characters-for-ai-provider-key-encryption
# Both access keys are required for the app UI. They must be different and at
# least 16 characters. The administrator can manage scans and AI; the visitor
# can only read published reports. Keep both values out of Git.
ADMIN_ACCESS_KEY=
VISITOR_ACCESS_KEY=
PRIVATE_EVIDENCE_ROOT=./private-inputs
PUBLIC_EXPORT_ROOT=./data/exports
APP_BASE_URL=http://localhost:3000
EGRESS_PROXY_IMAGE=replace-with-pinned-smokescreen-image-digest
SCAN_MAX_PAGES=15
SCAN_TIMEOUT_MS=30000
SCAN_DELAY_MS=500
SCAN_RETRY_COUNT=1
MAX_CRAWL_DEPTH=2
MAX_SITE_DURATION_MS=600000
EGRESS_PROXY_URL=
# Optional local-only fallback for networks whose system DNS returns synthetic
# private addresses. Keep `system` in production; DoH hostnames are sent to
# the configured HTTPS resolver and responses are still checked for private IPs.
DNS_RESOLVER_MODE=system
DNS_OVER_HTTPS_URL=https://dns.google/resolve
