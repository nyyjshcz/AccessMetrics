{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accesscheck.local/contracts/report-data-candidate.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactKind",
    "sourceExportId",
    "sourceManifestHash",
    "studyFreezeId",
    "populationDigest",
    "reviewFreezeHash",
    "reportLocalizationDraftHash",
    "modelDecisionHash",
    "modelObservationsHash",
    "createdFromCommit",
    "provenance",
    "sampleSummary",
    "pageStatusSummary",
    "frameCoverageSummary",
    "scores",
    "severitySummary",
    "commonRules",
    "principleSummary",
    "sensitivity",
    "manualValidation",
    "charts",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "report-data-candidate-v1" },
    "artifactKind": { "const": "candidate" },
    "sourceExportId": { "type": "string", "minLength": 1 },
    "sourceManifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "studyFreezeId": { "type": "string", "minLength": 1 },
    "populationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reportLocalizationDraftHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelDecisionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelObservationsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdFromCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "provenance": { "type": "object" },
    "sampleSummary": { "type": "object" },
    "pageStatusSummary": { "type": "object" },
    "frameCoverageSummary": { "$ref": "report-data.schema.json#/$defs/frameCoverageSummary" },
    "scores": { "$ref": "report-data.schema.json#/$defs/scores" },
    "severitySummary": { "type": "object" },
    "commonRules": { "type": "array", "items": { "type": "object" } },
    "principleSummary": { "type": "object" },
    "sensitivity": { "type": "object" },
    "manualValidation": { "$ref": "report-data.schema.json#/$defs/manualValidation" },
    "charts": { "$ref": "report-data.schema.json#/$defs/charts" },
    "limitations": { "$ref": "report-data.schema.json#/$defs/limitations" }
  }
}
