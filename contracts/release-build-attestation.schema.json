{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "releaseTag",
    "tagObject",
    "tagMessageHash",
    "finalCandidate",
    "rcCommit",
    "verifiedTreeHash",
    "buildContextTreeHash",
    "publicationRevisionLocked",
    "publicationRevisionReady",
    "fullGateBundleHash",
    "validationAttestationHash",
    "finalExportId",
    "finalManifestHash",
    "imageDigest",
    "ociLabelCommit",
    "embeddedProvenanceHash",
    "builtAt",
    "builderVersion",
    "attestationHash"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "release-build-attestation-v1" },
    "status": { "enum": ["passed", "failed", "blocked"] },
    "releaseTag": { "type": "string" },
    "tagObject": { "type": ["string", "null"] },
    "tagMessageHash": { "type": ["string", "null"] },
    "finalCandidate": { "type": "string" },
    "rcCommit": { "type": ["string", "null"] },
    "verifiedTreeHash": { "type": "string" },
    "buildContextTreeHash": { "type": "string" },
    "publicationRevisionLocked": { "type": "integer" },
    "publicationRevisionReady": { "type": "integer" },
    "fullGateBundleHash": { "type": "string" },
    "validationAttestationHash": { "type": "string" },
    "finalExportId": { "type": ["string", "null"] },
    "finalManifestHash": { "type": ["string", "null"] },
    "imageDigest": { "type": ["string", "null"] },
    "ociLabelCommit": { "type": ["string", "null"] },
    "embeddedProvenanceHash": { "type": ["string", "null"] },
    "builtAt": { "type": "string" },
    "builderVersion": { "type": "string" },
    "attestationHash": { "type": "string" }
  }
}
