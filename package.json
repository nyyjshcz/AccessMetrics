{
  "name": "accesscheck-lishui",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/index.ts",
    "ai:worker": "tsx --env-file-if-exists=.env.local src/worker/ai.ts",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.{ts,tsx}\" \"*.{json,ts,mjs}\" \"contracts/**/*.{json,yaml}\" \"configs/**/*.json\" \"scoring/**/*.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:scoring-parity": "vitest run tests/scoring",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:reset:test": "tsx scripts/db-reset-test.ts",
    "scan:page": "tsx scripts/scan-page.ts",
    "scan:one-page": "tsx scripts/scan-one-page.ts",
    "scan-one-page": "tsx scripts/scan-one-page.ts",
    "scan:site": "tsx scripts/scan-site.ts",
    "score:recalculate": "tsx scripts/recalculate-score.ts",
    "catalog:generate": "tsx scripts/generate-axe-catalog.ts",
    "localization:generate": "tsx scripts/generate-rule-localizations.ts",
    "catalog:build": "tsx scripts/build-axe-rule-catalog.ts",
    "build-axe-rule-catalog": "tsx scripts/build-axe-rule-catalog.ts",
    "catalog:check": "tsx scripts/check-wcag-catalog.ts",
    "recalculate-scores": "tsx scripts/recalculate-scores.ts",
    "backup:create": "tsx scripts/backup-create.ts",
    "backup:restore": "tsx scripts/backup-restore.ts",
    "ops:check": "tsx scripts/check-ops.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "axe-core": "4.13.0",
    "@libsql/client": "0.15.15",
    "@next/env": "16.3.0",
    "better-sqlite3": "13.0.3",
    "docx": "9.7.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "next": "16.3.0",
    "pino": "10.3.1",
    "playwright": "1.62.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "prettier": "3.8.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
