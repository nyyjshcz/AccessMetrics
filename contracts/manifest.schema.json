{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "exportId", "files", "generatedAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "canonical-manifest-json-v1" },
    "exportId": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^[^/].*" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "rows": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "generatedAt": { "type": "string" },
    "exportKind": { "enum": ["run", "study_source", "study_final", "study_final_ai"] },
    "kind": { "enum": ["run", "study_source", "study_final", "study_final_ai"] },
    "studyFreezeId": { "type": "string" },
    "freezeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "populationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "campaignPlanHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attemptLogHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executionLogHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runSetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceExportId": { "type": ["string", "null"] },
    "sourceManifestHash": { "type": ["string", "null"] },
    "outcomeDigest": { "type": ["string", "null"] },
    "reviewFreezeHash": { "type": ["string", "null"] },
    "reportLocalizationHash": { "type": ["string", "null"] },
    "scanTimeLocalizationHash": { "type": ["string", "null"] },
    "modelDecisionHash": { "type": ["string", "null"] },
    "modelObservationsHash": { "type": ["string", "null"] },
    "r4EvidenceBundleHash": { "type": ["string", "null"] },
    "aiBatchId": { "type": ["string", "null"] },
    "aiProviderSnapshotHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "aiPromptHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "aiSummaryHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedesExportId": { "type": ["string", "null"] },
    "publicationStatus": { "type": "string" },
    "appGitCommit": { "type": ["string", "null"] },
    "databaseMigration": { "type": ["integer", "null"] },
    "runIds": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "exportKind": { "const": "study_final_ai" } },
        "required": ["exportKind"]
      },
      "then": {
        "required": [
          "exportKind",
          "kind",
          "studyFreezeId",
          "freezeDigest",
          "populationDigest",
          "campaignPlanHash",
          "attemptLogHash",
          "executionLogHash",
          "runSetHash",
          "sourceExportId",
          "sourceManifestHash",
          "outcomeDigest",
          "aiBatchId",
          "aiProviderSnapshotHash",
          "aiPromptHash",
          "aiSummaryHash",
          "revision",
          "runIds"
        ],
        "properties": {
          "sourceExportId": { "type": "string", "minLength": 1 },
          "sourceManifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "outcomeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "aiBatchId": { "type": "string", "minLength": 1 },
          "aiProviderSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "aiPromptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "aiSummaryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reviewFreezeHash": { "const": null },
          "reportLocalizationHash": { "const": null },
          "modelDecisionHash": { "const": null },
          "modelObservationsHash": { "const": null },
          "r4EvidenceBundleHash": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": { "exportKind": { "const": "study_source" } },
        "required": ["exportKind"]
      },
      "then": {
        "required": [
          "exportKind",
          "kind",
          "studyFreezeId",
          "freezeDigest",
          "populationDigest",
          "campaignPlanHash",
          "attemptLogHash",
          "executionLogHash",
          "runSetHash",
          "sourceExportId",
          "sourceManifestHash",
          "outcomeDigest",
          "reviewFreezeHash",
          "reportLocalizationHash",
          "modelDecisionHash",
          "modelObservationsHash",
          "r4EvidenceBundleHash",
          "revision",
          "runIds"
        ],
        "properties": {
          "revision": { "const": 1 },
          "sourceExportId": { "const": null },
          "sourceManifestHash": { "const": null },
          "outcomeDigest": { "const": null },
          "reviewFreezeHash": { "const": null },
          "reportLocalizationHash": { "const": null },
          "modelDecisionHash": { "const": null },
          "modelObservationsHash": { "const": null },
          "r4EvidenceBundleHash": { "const": null }
        },
        "not": {
          "properties": {
            "files": {
              "contains": {
                "properties": {
                  "path": { "pattern": "^(analysis/|configs/rule-localizations\\.report)" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "exportKind": { "const": "study_final" } },
        "required": ["exportKind"]
      },
      "then": {
        "required": [
          "exportKind",
          "kind",
          "studyFreezeId",
          "freezeDigest",
          "populationDigest",
          "campaignPlanHash",
          "attemptLogHash",
          "executionLogHash",
          "runSetHash",
          "sourceExportId",
          "sourceManifestHash",
          "outcomeDigest",
          "reviewFreezeHash",
          "reportLocalizationHash",
          "modelDecisionHash",
          "modelObservationsHash",
          "r4EvidenceBundleHash",
          "revision",
          "runIds"
        ],
        "properties": {
          "sourceExportId": { "type": "string", "minLength": 1 },
          "sourceManifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "outcomeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reviewFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reportLocalizationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "modelDecisionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "modelObservationsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "r4EvidenceBundleHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  ]
}
